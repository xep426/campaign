<?xml version="1.0" encoding="utf-8"?>
<!-- The window shell only — everything inside the app is themed by
     CampaignTheme in Compose. A platform parent rather than a Material
     Components one, because this app does not depend on the Material XML
     library and does not need to.

     windowBackground is the dusk ink so the launch frame matches the first
     composed frame; a default white flash before a dark app is the most
     avoidable jarring moment there is. And no DayNight parent: Campaign
     has one palette (see CampaignTheme). -->
<resources>
    <style name="Theme.Campaign" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
