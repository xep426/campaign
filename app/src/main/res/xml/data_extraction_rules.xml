<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ split cloud backup from device-to-device transfer. Both
     carry the same content here — see backup_rules.xml for why all of it
     is included. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
